# Copy to .env and fill in. Never commit it.
VIDEXO_API_URL=https://api.videxo.io
VIDEXO_API_KEY=
VIDEXO_WEBHOOK_SECRET=
# A public https URL of this app's /webhooks/videxo (a tunnel in development); optional.
VIDEXO_WEBHOOK_URL=
# The built server (adapter-node) refuses bodies over 512 KB by default; a webhook carries the whole job.
BODY_SIZE_LIMIT=2M
